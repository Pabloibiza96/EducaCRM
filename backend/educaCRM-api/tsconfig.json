{
  "compilerOptions": {
    /* Entorno Node.js + ESM */
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],

    /* Necesario para TypeORM (decoradores) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    /* TypeScript estricto pero manejable */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],

    /* Otros útiles */
    "sourceMap": true
  },
  "include": ["src"]
}