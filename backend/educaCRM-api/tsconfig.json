{
  "compilerOptions": {
    /* Salida de compilación */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Entorno Node.js */
    "module": "nodenext",
    "target": "es2020",
    "lib": ["ES2020"],
    "moduleResolution": "nodenext",
    "types": ["nodenext"],

    /* Necesario para TypeORM (decoradores) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* TypeScript estricto pero manejable */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* Otros útiles */
    "sourceMap": true
  },
  "include": ["src"]
}